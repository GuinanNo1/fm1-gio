# the panel: the white keys play the lead, the Setup page's Key moves the key, SEL the next section, REC holds,
# ALGORITHM the pattern, OCT the bass, HOME + SELECT the tempo (110 .. 130)
intro off
wait 500
key w2 down
wait 100
expect leadstep 2
key w2 up
wait 100
expect leadstep -1
expect key 0
tap GLO
spin K1 9
wait 100
expect par24 9
expect key 9
spin K1 -2
wait 100
expect key 7
tap HOME
# SEL: the next section on the next bar
expect section 0
tap SEL
wait 2500
expect section 1
# REC: the section holds; the verse's 16 bars come and go, it stays
tap REC
wait 100
expect held 1
wait 40000
expect section 1
shot hold.png
tap REC
wait 100
expect held 0
# ALGORITHM: the pattern
turn ALGO 4
expect par27 4
wait 2000
shot gallop.png
turn ALGO -4
expect par27 0
# OCT: the bass's octave, from -1 to +1
tap OCT+
expect par28 1
tap OCT+
expect par28 1
tap OCT-
tap OCT-
expect par28 -1
tap OCT+
# the tempo, with HOME held: never past 130
press HOME
spin SELECT 10
release HOME
expect par0 130
press HOME
spin SELECT -40
release HOME
expect par0 110
# MIDI in: a note on channel 1 moves the key; a clock drives the grid only from the port the MIDI page names
midi 90 3E 64
wait 100
expect key 2
clock 96
expect ext 0
tap GLO
tap GLO
expect view 13
spin K3 1
expect par34 1
clock 96
expect ext 1
