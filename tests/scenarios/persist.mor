# saved and back after a restart: the song, its settings, the lights; a project another firmware left there
# (another magic) gives the defaults
wait 300
turn PRESET 5
expect piece 5
tap LFO
spin K1 -15
expect par12 35
tap GLO
spin K4 1
tap SAVE
wait 300
expect dirty 0
reboot
wait 500
expect piece 5
expect par12 35
expect par0 123
expect playing 1
